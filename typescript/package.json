{
  "name": "@zerosix-studio/cryptoetf",
  "version": "1.0.0",
  "description": "Official TypeScript client for the CryptoETF API: daily net flows of US spot crypto ETFs for 16 assets (BTC, ETH, SOL, XRP, HYPE, DOGE, LINK, AVAX, HBAR, LTC, BNB, DOT, SUI, NEAR, TRX, ZEC), fund by fund, plus fund AUM, the CEFI sentiment index and coin prices. Zero dependencies.",
  "keywords": [
    "crypto",
    "etf",
    "bitcoin-etf",
    "ethereum-etf",
    "etf-flows",
    "spot-etf",
    "ibit",
    "api",
    "sdk"
  ],
  "homepage": "https://cryptoetf.today/en/api",
  "bugs": {
    "url": "https://github.com/zerosix-studio/cryptoetf-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerosix-studio/cryptoetf-sdk.git",
    "directory": "typescript"
  },
  "license": "MIT",
  "author": "cryptoetf.today",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
